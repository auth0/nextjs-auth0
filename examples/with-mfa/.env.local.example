# Auth0 tenant domain, e.g. dev-abc123.us.auth0.com
AUTH0_DOMAIN=

# Application credentials (Auth0 Dashboard > Applications > your app > Settings)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Session encryption key, at least 32 characters. openssl rand -hex 32
AUTH0_SECRET=

# Base URL of this app
APP_BASE_URL=http://localhost:3000

# The API that needs MFA (the Action is set up for this audience)
NEXT_PUBLIC_AUTH0_AUDIENCE=
